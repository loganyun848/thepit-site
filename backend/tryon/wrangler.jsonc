{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thepit-tryon",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://the-pit.site,https://www.the-pit.site",
    "DAILY_LIMIT": "50",
    "VISITOR_DAILY_LIMIT": "50"
  },
  "durable_objects": { "bindings": [{ "name": "TRYON_GATE", "class_name": "TryOnGate" }, {"name":"PRODUCTION_QUEUE","class_name":"ProductionQueue"}] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TryOnGate"] }, {"tag":"v2-motion","new_sqlite_classes":["ProductionQueue"]}],
  "observability": { "enabled": false }
}
